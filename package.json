{
  "name": "edgemesh-shopify-demo-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "shopify theme check && node --test tests/*.test.mjs",
    "dev": "shopify theme dev --store edgemesh.myshopify.com",
