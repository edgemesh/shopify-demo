<div class="em-announcement">
  <span>THE EDGEMESH DEMO STORE</span>
  <a href="{{ routes.root_url }}#dynamic-content">See what happens behind the scenes <span aria-hidden="true">{% render 'edgemesh-icon', name: 'arrow-up-right' %}</span></a>
</div>
<header class="em-header">
  <div class="em-container em-header-inner">
    <a href="{{ routes.root_url }}" class="em-logo" aria-label="Edgemesh home">
      <img src="{{ 'edgemesh-wordmark.png' | asset_url }}" width="180" height="23" alt="Edgemesh" loading="eager">
    </a>
    <nav class="em-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}#stack">Explore the stack</a>
      <a href="{{ routes.root_url }}#dynamic-content">How this demo works</a>
      <a href="https://edgemesh.com" target="_blank" rel="noopener">Edgemesh.com <span aria-hidden="true">{% render 'edgemesh-icon', name: 'arrow-up-right' %}</span></a>
    </nav>
    <div class="em-cart-action">
      <span class="em-fragment-label">DYNAMIC FRAGMENT</span>
      {% render 'header-actions', section: section, display_style: 'text' %}
      <noscript><a href="{{ routes.cart_url }}">View cart</a><style>.em-cart-action header-actions{display:none}</style></noscript>
    </div>
    <details class="em-mobile-nav">
      <summary aria-label="Navigation menu">{% render 'edgemesh-icon', name: 'menu' %}</summary>
      <nav aria-label="Mobile navigation">
        <a href="{{ routes.root_url }}#stack">Explore the stack</a>
        <a href="{{ routes.root_url }}#dynamic-content">How this demo works</a>
        <a href="https://edgemesh.com">Edgemesh.com {% render 'edgemesh-icon', name: 'arrow-up-right' %}</a>
      </nav>
    </details>
  </div>
</header>
{% schema %}
{"name":"Edgemesh header","settings":[],"enabled_on":{"groups":["header"]}}
{% endschema %}
